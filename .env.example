# ---------- Groq (required) ----------
# Create at https://console.groq.com/keys
VITE_GROQ_API_KEY=
VITE_GROQ_BASE_URL=https://api.groq.com/openai/v1
VITE_GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high
VITE_GROQ_REASONING_EFFORT=low
VITE_GROQ_TEMPERATURE=0.7
VITE_GROQ_MAX_TOKENS=6000

# ---------- Firebase (required) ----------
# Firebase console, Project settings, Your apps, Web app, SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional, only if Analytics is enabled
VITE_FIREBASE_MEASUREMENT_ID=

# ---------- Cover images (Pollinations) ----------
# Without a key the free flux model is used through the legacy endpoint.
VITE_POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
# With a key (free account at enter.pollinations.ai) the unified API below is used and you can pick a stronger model.
VITE_POLLINATIONS_TOKEN=
VITE_POLLINATIONS_API_URL=https://gen.pollinations.ai/image
# Models your key can use are listed at https://gen.pollinations.ai/image/models (for example flux, nanobanana, gptimage)
VITE_POLLINATIONS_MODEL=flux
