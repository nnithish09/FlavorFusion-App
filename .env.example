# ---------- Groq (client-side; this key is exposed in the browser by Vite) ----------
# Restrict this key in your Groq account where possible. For production-grade secrecy,
# move Groq calls behind a serverless endpoint as well.
VITE_GROQ_API_KEY=
VITE_GROQ_BASE_URL=https://api.groq.com/openai/v1
VITE_GROQ_MODEL=openai/gpt-oss-120b
VITE_GROQ_REASONING_EFFORT=low
VITE_GROQ_TEMPERATURE=0.7
VITE_GROQ_MAX_TOKENS=6000

# ---------- Firebase Web App config (public client configuration) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------- Server-only Vercel environment variables ----------
# Never prefix these with VITE_. Add them in Vercel Project Settings > Environment Variables.
GEMINI_API_KEY=
# Full Firebase Admin SDK service-account JSON, kept server-side only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Exact production origin; comma-separate preview/local origins only if you need them.
ALLOWED_ORIGINS=
